# MySQL 8.4 برای سرویس خصوصی Render — عمداً همان تگ `mysql:8.4` محیط توسعه
# (docker-compose.yml) تا رفتار دو محیط یکی بماند.
#
# سرویس خصوصی در render.yaml یک دیسک ماندگار روی /var/lib/mysql دارد — دقیقاً
# همان مسیری که ایمیج رسمی داده‌اش را در آن می‌نویسد؛ مسیر دیگر یعنی از دست
# رفتن داده‌ها (راهنمای رسمی Render: Deploy MySQL).
FROM mysql:8.4

# Copy this file to `.env` and fill the values.
#
# Sansyar runs ONLY inside the Eitaa mini app (برنامک).
# There is no SMS, no OTP and no phone-number login anywhere in this product.
# The only number it holds is the player's contact number (`User.phone`), typed
# once on the first run and shown to the manager only — never an identity.

# MySQL (matches docker-compose.yml)
# The Prisma 7 driver adapter is the MariaDB driver, which speaks the MySQL
# protocol — this URL works unchanged against MySQL 8 or MariaDB.
DATABASE_URL="mysql://root:sansyar@127.0.0.1:3306/sansyar"

# Session signing secret — generate a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET="change-me-to-a-long-random-string"

# Eitaa user id(s) that get the ADMIN role. Comma-separated for more than one.
# Get yours from inside the app: Profile → «شناسه‌ی من» (the numeric eitaaId).
ADMIN_EITAA_ID=""

# Public base URL of the app — used to build absolute links in the session share message.
APP_URL="http://localhost:3000"

# ⚠️ Values containing `$` must escape it as `\$`. Next.js loads this file through
# dotenv-expand, so a bare `$NAME` is treated as a variable reference and REPLACED WITH "".
# Run `npm.cmd run check:env` after editing this file (it caught exactly this bug once).
#
# Eitaa mini app (برنامک) — app token from the EitaaYar panel (eitaayar.ir).
# REQUIRED: without it initData verification fails (only the dev simulator keeps working).
# SERVER-ONLY: never expose this to the client (no NEXT_PUBLIC_ prefix).
EITAA_BOT_TOKEN=""

# Eitaa app username / shortname (e.g. `opensansyar`).
# NOTE: the EitaaYar panel composes the app link as https://eitaa.com/<account>/<shortname>
# (a two-segment path), which the URL below cannot build from the username alone — for such
# apps set EITAA_LINK_TEMPLATE explicitly.
EITAA_APP_USERNAME=""

# Optional: override the mini-app link template. `{start}` is replaced with the start param
# (e.g. `s_12`). Default: https://eitaa.com/<EITAA_APP_USERNAME>?startapp={start}
# The Android-only `&btn=` button label is appended by src/lib/eitaa-link.ts — don't add it here.
# ⚠️ The exact parameter format is undocumented — verify on a real device and fix it here only.
EITAA_LINK_TEMPLATE=""

# Dev-only login simulator (locally signed initData). Ignored when NODE_ENV=production.
EITAA_DEV_LOGIN="1"

# Optional: token used to sign the simulated initData. Defaults to EITAA_BOT_TOKEN,
# falling back to a fixed test token.
EITAA_DEV_BOT_TOKEN=""
